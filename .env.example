# 复制为 .env 后按需修改；此文件不填写真实密钥。
APP_NAME=桌面物品清点
APP_ENV=development
YOLO_MODEL_PATH=models/yolo11n.pt
# auto 优先使用可用 GPU，也可指定 cpu 或 0。
YOLO_DEVICE=auto
SAM_MODEL_PATH=models/sam2.1_t.pt
# 默认将人和大型家具从物品清单中单独列出，使用模型英文类别名。
INVENTORY_EXCLUDED_LABELS=["person","dining table","chair","couch","bed"]
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_SIDE=1600
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=
# 单次远程调用的总时限，不自动重试。
VISION_TIMEOUT_SECONDS=120
VISION_MAX_OUTPUT_TOKENS=4096
# json_object 兼容常见服务；支持严格结构时可用 json_schema；text 仅靠提示约束。
VISION_RESPONSE_MODE=json_object
# 部分兼容服务只接受 max_tokens，按服务文档修改。
VISION_TOKEN_LIMIT_FIELD=max_completion_tokens
