# 复制为 .env 后按需修改；此文件不填写真实密钥。
APP_NAME=桌面物品清点
APP_ENV=development
YOLO_MODEL_PATH=models/yolo11n.pt
# auto 优先使用可用 GPU，也可指定 cpu 或 0。
YOLO_DEVICE=auto
SAM_MODEL_PATH=models/sam2.1_t.pt
# 默认将人和大型家具从物品清单中单独列出，使用模型英文类别名。
INVENTORY_EXCLUDED_LABELS=["person","dining table","chair","couch","bed"]
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_PIXELS=20000000
MAX_IMAGE_SIDE=1600
VISION_API_BASE_URL=https://api.openai.com/v1
VISION_API_KEY=
VISION_MODEL=
